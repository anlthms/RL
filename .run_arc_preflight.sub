#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --partition=cpu
#SBATCH --qos=cpu-normal
#SBATCH --cpus-per-task=8
#SBATCH --time=00:20:00
#SBATCH --job-name=nemotron_sw_post:arc-preflight
#SBATCH --account=nemotron_sw_post
#SBATCH --output=%j-arc-preflight.log

# Resolve the M4.1 config and build its datasets on a CPU node, before the
# launch spends GPU nodes on them. See .run_arc_tests.sub for why
# `--no-container-mount-home` and the `cpu` partition are load-bearing.

REPO=/lustre/fs1/portfolios/nemotron/projects/nemotron_sw_pre/users/anthomas/RL5
CONTAINER=/lustre/fs1/portfolios/llmservice/projects/llmservice_fm_text/users/tene/nemo_rl_0804.sqsh
MOUNTS="/lustre:/lustre,/home:/home,${REPO}:/opt/nemo-rl"

srun --no-container-mount-home \
     --container-image="$CONTAINER" \
     --container-mounts="$MOUNTS" \
     --container-workdir="$REPO" \
     bash -c '
echo "===== M4.1: identity gate (levels=[0]) ====="
uv run tools/arc_synth_preflight.py \
  --config examples/configs/async/qwen3_1p7b_arcsynth_colocated.yaml \
  grpo.max_num_steps=20 data.train.levels=[0] \
  grpo.val_at_start=true grpo.val_period=10 2>&1 | tail -30
echo
echo "===== M4.3: full ladder (config default) ====="
uv run tools/arc_synth_preflight.py \
  --config examples/configs/async/qwen3_1p7b_arcsynth_colocated.yaml 2>&1 | tail -30
'
