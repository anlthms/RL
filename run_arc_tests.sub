#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --partition=cpu
#SBATCH --qos=cpu-normal
#SBATCH --cpus-per-task=8
#SBATCH --time=00:30:00
#SBATCH --job-name=nemotron_sw_post:arc-unit-tests
#SBATCH --account=nemotron_sw_post
#SBATCH --output=%j-arc-tests.log

set -euo pipefail

# The ARC unit tests, in the container. The grid and generator modules are
# stdlib-only and run on a login node, but the dataset tests need HF `datasets`
# and the environment tests need Ray, so those two files only run here.
#
# `--no-container-mount-home` is the load-bearing flag: without it enroot mounts
# the caller's host home over the container's, which hides the image's `uv` and
# produces a "uv: command not found" that looks like a broken image. Do not add
# `${HOME}:${HOME}` to MOUNTS for the same reason.
#
# Runs on the `cpu` partition, not `batch`/`interactive`. Scoring is pure
# Python and the Ray actor needs no device, so a GPU node buys nothing -- and
# the interactive QOS caps a user at 4 nodes total, where a training run wants
# every one of them. Tests should never queue behind, or displace, an
# experiment.
#
# UV_PYTHON is deliberately not set. launch_experiment.sh unsets it (see the
# comment there): everything runs on the 3.13.13 interpreter the container
# ships, because Ray compares cluster and worker interpreter versions exactly.

REPO=/lustre/fs1/portfolios/nemotron/projects/nemotron_sw_pre/users/anthomas/RL5
CONTAINER=/lustre/fs1/portfolios/llmservice/projects/llmservice_fm_text/users/tene/nemo_rl_0804.sqsh
MOUNTS="/lustre:/lustre,/home:/home,${REPO}:/opt/nemo-rl"

srun --no-container-mount-home \
     --container-image="$CONTAINER" \
     --container-mounts="$MOUNTS" \
     --container-workdir="$REPO" \
     bash -c '
echo "uv -> $(command -v uv)"
echo "===== arc unit tests ====="
uv run --group test pytest -q -p no:cacheprovider --no-header -p no:randomly \
  --tb=long -rf --maxfail=100 \
  tests/unit/environments/test_arc_agi_grid.py \
  tests/unit/environments/test_arc_agi_generators.py \
  tests/unit/environments/test_arc_agi_environment.py \
  tests/unit/data/datasets/test_arc_synth_dataset.py 2>&1 | grep -v "^PASSED" | tail -80
'
