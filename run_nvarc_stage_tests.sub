#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --partition=cpu
#SBATCH --qos=cpu-normal
#SBATCH --cpus-per-task=8
#SBATCH --time=00:30:00
#SBATCH --job-name=nemotron_sw_post:nvarc-stage-tests
#SBATCH --account=nemotron_sw_post
#SBATCH --output=/lustre/fs1/portfolios/nemotron/projects/nemotron_sw_pre/users/anthomas/RL7/reports/nvarc_stage_tests.log

set -euo pipefail

REPO=/lustre/fs1/portfolios/nemotron/projects/nemotron_sw_pre/users/anthomas/RL7
# The training container. Its /etc/environment puts /opt/nemo_rl_venv/bin on
# PATH and sets UV_PROJECT_ENVIRONMENT, so pytest/ruff/pyrefly resolve without
# spelling a venv path. --no-container-mount-home is load-bearing: mounting
# the host home over /root masks the image's uv interpreter and cache, which
# every pure-python site-package symlinks into.
CONTAINER=/lustre/fs1/portfolios/llmservice/projects/llmservice_fm_text/users/tene/nemo_rl_0807.sqsh
MOUNTS="/lustre:/lustre,/home:/home,${REPO}:/opt/nemo-rl"

srun --no-container-mount-home \
  --container-image="${CONTAINER}" \
  --container-mounts="${MOUNTS}" \
  --container-workdir="${REPO}" \
  bash -c "
set -euo pipefail
pytest -q -p no:cacheprovider --no-header \
  -p no:randomly --tb=long -rf --maxfail=100 \
  tests/unit/environments/test_arc_agi_grid.py \
  tests/unit/environments/test_arc_agi_environment.py \
  tests/unit/data/datasets/test_arc_agi_dataset.py \
  tests/unit/data/datasets/test_nvarc_executor_dataset.py \
  tests/unit/tools/test_nvarc_ingest.py \
  tests/unit/tools/test_nvarc_executor_benchmark.py \
  'tests/unit/data/test_data_processor.py::test_arc_executor_processor_keeps_target_out_of_the_prompt'

ruff check \
  tools/nvarc_ingest.py \
  tools/nvarc_chat_dump.py \
  tools/nvarc_executor_benchmark.py \
  tools/nvarc_executor_benchmark_megatron.py \
  tools/nvarc_executor_train_preflight.py \
  nemo_rl/data/datasets/response_datasets/nvarc_executor.py \
  nemo_rl/data/datasets/response_datasets/arc_agi.py \
  nemo_rl/environments/arc_agi_grid.py \
  nemo_rl/environments/arc_agi_environment.py \
  tests/unit/tools/test_nvarc_ingest.py \
  tests/unit/data/datasets/test_nvarc_executor_dataset.py \
  tests/unit/data/datasets/test_arc_agi_dataset.py \
  tests/unit/tools/test_nvarc_executor_benchmark.py

ruff format --check \
  tools/nvarc_ingest.py \
  tools/nvarc_chat_dump.py \
  tools/nvarc_executor_benchmark.py \
  tools/nvarc_executor_benchmark_megatron.py \
  tools/nvarc_executor_train_preflight.py \
  nemo_rl/data/datasets/response_datasets/nvarc_executor.py \
  nemo_rl/data/datasets/response_datasets/arc_agi.py \
  tests/unit/tools/test_nvarc_ingest.py \
  tests/unit/data/datasets/test_nvarc_executor_dataset.py \
  tests/unit/data/datasets/test_arc_agi_dataset.py \
  tests/unit/tools/test_nvarc_executor_benchmark.py

pyrefly check \
  tools/nvarc_ingest.py \
  tools/nvarc_chat_dump.py \
  nemo_rl/data/datasets/response_datasets/nvarc_executor.py \
  nemo_rl/data/datasets/response_datasets/arc_agi.py \
  tools/nvarc_executor_benchmark.py \
  tools/nvarc_executor_benchmark_megatron.py \
  tools/nvarc_executor_train_preflight.py

echo ALL_STAGE_CHECKS_PASSED
"
